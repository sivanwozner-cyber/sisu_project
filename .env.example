# Database (Supabase Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# BrightData (benefits scraping only — server-side)
BRIGHTDATA_API_TOKEN=""

# Claude API (LLM fallback extraction only)
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-4-6"

# Price-feed ingestion — official transparency portals (server-side only)
# Cerberus portal (Rami Levy / Carrefour / Yochananof) — base URL is public, not a secret
CERBERUS_BASE_URL="https://url.publishedprices.co.il"
RAMI_LEVY_USERNAME=""
RAMI_LEVY_PASSWORD=""
RAMI_LEVY_BRANCH_ID=""
CARREFOUR_USERNAME=""
CARREFOUR_PASSWORD=""
CARREFOUR_BRANCH_ID=""
YOCHANANOF_USERNAME=""
YOCHANANOF_PASSWORD=""
YOCHANANOF_BRANCH_ID=""
# Shufersal independent portal — base URL is public, not a secret
SHUFERSAL_BASE_URL="https://prices.shufersal.co.il"
