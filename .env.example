# Database (Supabase Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# BrightData (benefits scraping only — server-side)
BRIGHTDATA_API_TOKEN=""
# Web Unlocker zone provisioned for benefits scraping (required for live fetch).
BRIGHTDATA_ZONE=""
# Optional override of the BrightData REST endpoint.
# BRIGHTDATA_API_URL="https://api.brightdata.com/request"

# Claude API (LLM fallback extraction only)
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-4-6"
